# Optional official/API-backed credentials. Desktop login is available for
# Douyin, Weibo, Xiaohongshu, Bilibili, X and Instagram (see README).
X_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v26.0
WEIBO_ACCESS_TOKEN=
WEIBO_COOKIE=
# Optional Playwright session paths. In-app login saves/reuses these automatically.
# Empty paths use separate .cache/<platform>-session.json files.
WEIBO_BROWSER_STORAGE_STATE=
XHS_BROWSER_STORAGE_STATE=
BILIBILI_BROWSER_STORAGE_STATE=
X_BROWSER_STORAGE_STATE=
INSTAGRAM_BROWSER_STORAGE_STATE=
BILIBILI_COOKIE=
NATIVE_API_TIMEOUT_SECONDS=12

# Optional public-page fallback for XHS/Weibo when no JSON gateway is available.
BROWSER_FALLBACK=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_POLL_MS=500
BROWSER_CDP_URL=
BROWSER_USER_DATA_DIR=
BROWSER_CHANNEL=
SEARCH_TIMEOUT_SECONDS=55
PLATFORM_TIMEOUT_SECONDS=50
CREATOR_TIMEOUT_SECONDS=120
OBJECT_FILTER_TIMEOUT_SECONDS=4

# Optional local semantic reranking, e.g. BAAI/bge-small-zh-v1.5.
# Leave empty to use the fast rule-based ranker only.
SEMANTIC_MODEL=
SEMANTIC_TIMEOUT_SECONDS=4

# Local visual reranking. Keep this model cached locally when
# VISION_LOCAL_ONLY=true; loading happens in the background with a strict
# per-request budget.
VISION_MODEL=openai/clip-vit-base-patch32
VISION_TIMEOUT_SECONDS=8
VISION_LOCAL_ONLY=true
VISION_IMAGE_TIMEOUT_SECONDS=8
OBJECT_MODEL=
# Optional JSON mapping from model labels to person/clothing/landscape/etc.
# Example: {"person":"person","shirt":"clothing","mountain":"landscape"}
OBJECT_LABEL_MAP=
OBJECT_CONFIDENCE=0.35

# Recommended source projects. Commands must print JSON records to stdout.
# Placeholders: {platform}, {query}, {item_id}, {url}, {limit}
# The bundled bridges are metadata-only: they never download images.
# Blank values automatically use this checkout's bridges and Python environment.
# Explicit custom commands remain supported.
MEDIA_CRAWLER_COMMAND=
XHS_DOWNLOADER_COMMAND=
DOUYIN_SOURCE_COMMAND=
BILIBILI_SOURCE_COMMAND=
MEDIA_CRAWLER_ROOT=
MEDIA_CRAWLER_LOGIN_TYPE=qrcode
MEDIA_CRAWLER_HEADLESS=true
MEDIA_CRAWLER_BROWSER_PATH=
MEDIA_CRAWLER_SLEEP_SECONDS=0.25
DOUYIN_CREATOR_SLEEP_SECONDS=0.25
XHS_DOWNLOADER_ROOT=
GALLERY_DL_BINARY=gallery-dl
GALLERY_DL_CONFIG=
# Optional: edge, chrome, firefox, or a browser/profile selector supported by gallery-dl.
# Leave empty unless the browser is logged into the target platform.
GALLERY_DL_COOKIES_FROM_BROWSER=
# Optional legacy Netscape session file. In-app X/Instagram sessions take
# precedence and are exported automatically, without browser cookie decryption.
GALLERY_DL_COOKIES_FILE=
# Platform-specific sessions take precedence and keep X/Instagram isolated.
X_GALLERY_DL_COOKIES_FROM_BROWSER=
X_GALLERY_DL_COOKIES_FILE=
INSTAGRAM_GALLERY_DL_COOKIES_FROM_BROWSER=
INSTAGRAM_GALLERY_DL_COOKIES_FILE=
SOURCE_TIMEOUT_SECONDS=45
SOURCE_FAILURE_COOLDOWN_SECONDS=120
SOURCE_VERIFICATION_PATH=.cache/source-verification.json
SOURCE_VERIFICATION_TTL_SECONDS=86400
DOUYIN_SOURCE_TIMEOUT_SECONDS=45
# Avoid an extra Douyin request at every desktop launch. Set true only when a
# live startup probe is explicitly required; probe failure never blocks the UI.
PREFLIGHT_DOUYIN_HEALTH_CHECK=false
PREFLIGHT_LIVE_CHECKS=false
PREFLIGHT_AUTO_LOGIN=false
# Video batches are awaited sequentially. Keep concurrency at 1 for the
# gentlest default; failed/duplicate items are replaced from later candidates.
VIDEO_DOWNLOAD_BATCH_SIZE=3
VIDEO_DOWNLOAD_CONCURRENCY=1
IMAGE_DOWNLOAD_BATCH_SIZE=10
IMAGE_DOWNLOAD_CONCURRENCY=3
DOUYIN_BROWSER_FALLBACK=false
DOUYIN_BROWSER_POLL_MS=400
DY_CLI_RESULT_CACHE=.cache/dy-cli-results.json

# Douyin/Xiaohongshu/Weibo can be connected through a compliant JSON gateway.
# The gateway should accept GET params: query, item_id, limit, safe_mode.
DOUYIN_SEARCH_ENDPOINT=
DOUYIN_ITEM_ENDPOINT=
DOUYIN_COOKIE=
DOUYIN_SKILL_PATH=~/.agents/skills/douyin-spider
DOUYIN_NATIVE_SKILL=true
XHS_SEARCH_ENDPOINT=
XHS_ITEM_ENDPOINT=
XHS_COOKIES=
WEIBO_SEARCH_ENDPOINT=
WEIBO_ITEM_ENDPOINT=

SOCIAL_IMAGE_CACHE=.cache/social-image-mcp.sqlite3
SOCIAL_IMAGE_OUTPUT=downloads
